generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ISSUE_CLERK
  FINANCE_HEAD
}

enum JobStatus {
  OPEN
  PARTIALLY_RETURNED
  COMPLETED
  CANCELLED
}

enum TransactionType {
  ISSUE
  RECEIPT
}

enum ReturnType {
  FINISHED_JEWELLERY
  SCRAP
  FILINGS
}

enum ReturnReviewStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
}

enum WastageReviewStatus {
  PROVISIONAL
  FINAL
}

enum WastageAlertStatus {
  PENDING
  RESOLVED
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String            @db.VarChar(120)
  email               String            @unique @db.VarChar(255)
  passwordHash        String            @db.VarChar(255)
  role                UserRole
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdTransactions GoldTransaction[] @relation("TransactionCreatedBy")
  auditLogs           AuditLog[]
  reviewedReturns     ReturnReview[] @relation("ReturnReviewReviewer")
  submittedWastageReviews WastageReview[] @relation("WastageReviewSubmittedBy")
  approvedWastageReviews  WastageReview[] @relation("WastageReviewApprovedBy")
  resolvedWastageAlerts   WastageAlert[]  @relation("WastageAlertResolvedBy")
}

model Karigar {
  id               String            @id @default(uuid()) @db.Uuid
  karigarCode      String            @unique @db.VarChar(32)
  name             String            @db.VarChar(120)
  phone            String            @db.VarChar(30)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  wastageRules     WastageRule[]
  jobs             Job[]
  goldTransactions GoldTransaction[]
}

model WastageRule {
  id                    String   @id @default(uuid()) @db.Uuid
  karigarId             String   @db.Uuid
  itemCategory          String   @db.VarChar(80)
  allowedWastagePercent Decimal  @db.Decimal(6, 3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  karigar               Karigar  @relation(fields: [karigarId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([karigarId, itemCategory])
}

model Job {
  id           String            @id @default(uuid()) @db.Uuid
  jobNumber    String            @unique @db.VarChar(64)
  karigarId    String            @db.Uuid
  itemCategory String            @db.VarChar(80)
  dueDate      DateTime          @db.Date
  notes        String?           @db.VarChar(500)
  appliedWastagePercent Decimal   @default(0) @db.Decimal(6, 3)
  status       JobStatus         @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  karigar      Karigar           @relation(fields: [karigarId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions GoldTransaction[]
  wastageReviews WastageReview[]
  wastageAlerts WastageAlert[]
}

model GoldTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  transactionId   String          @unique @db.VarChar(64)
  transactionType TransactionType
  jobId           String          @db.Uuid
  karigarId       String          @db.Uuid
  grossWeight     Decimal         @db.Decimal(12, 3)
  purity          Decimal         @db.Decimal(5, 2)
  fineWeight      Decimal         @db.Decimal(12, 3)
  createdById     String          @db.Uuid
  returnType      ReturnType?
  notes           String?         @db.VarChar(500)
  createdAt       DateTime        @default(now())
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  karigar         Karigar         @relation(fields: [karigarId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User            @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  returnReview    ReturnReview?
}

model ReturnReview {
  id              String             @id @default(uuid()) @db.Uuid
  transactionId   String             @unique @db.Uuid
  status          ReturnReviewStatus @default(PENDING_REVIEW)
  reviewerId      String?            @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?            @db.VarChar(500)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  transaction     GoldTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer        User?              @relation("ReturnReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(64)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model WastageReview {
  id                 String              @id @default(uuid()) @db.Uuid
  jobId              String              @db.Uuid
  reviewEvent        String              @db.VarChar(40)
  status             WastageReviewStatus
  issuedFineGold     Decimal             @db.Decimal(12, 3)
  returnedFineGold   Decimal             @db.Decimal(12, 3)
  allowedWastage     Decimal             @db.Decimal(12, 3)
  actualDifference   Decimal             @db.Decimal(12, 3)
  excessWastage      Decimal             @db.Decimal(12, 3)
  submittedById      String              @db.Uuid
  approvedById       String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy        User                @relation("WastageReviewSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy         User?               @relation("WastageReviewApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([jobId, reviewEvent])
  @@index([status])
}

model WastageAlert {
  id               String             @id @default(uuid()) @db.Uuid
  jobId            String             @db.Uuid
  reviewEvent      String             @db.VarChar(40)
  status           WastageAlertStatus @default(PENDING)
  karigarCode      String             @db.VarChar(32)
  karigarName      String             @db.VarChar(120)
  jobNumber        String             @db.VarChar(64)
  itemCategory     String             @db.VarChar(80)
  issuedFineGold   Decimal            @db.Decimal(12, 3)
  returnedFineGold Decimal            @db.Decimal(12, 3)
  allowedWastage   Decimal            @db.Decimal(12, 3)
  actualDifference Decimal            @db.Decimal(12, 3)
  excessWastage    Decimal            @db.Decimal(12, 3)
  resolvedById     String?            @db.Uuid
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  job              Job                @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy       User?              @relation("WastageAlertResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([jobId, reviewEvent])
  @@index([status])
}
